{
  "default_provider": "backend-a",
  "providers": [
    {
      "name": "backend-a",
      "enabled": true,
      "api_key": "${MRLIOU_BACKEND_A_KEY}",
      "base_url": "${MRLIOU_BACKEND_A_URL}",
      "default_model": "mrliou-model-a1",
      "models": [
        "mrliou-model-a1",
        "mrliou-model-a2",
        "mrliou-model-a3"
      ]
    },
    {
      "name": "backend-b",
      "enabled": true,
      "api_key": "${MRLIOU_BACKEND_B_KEY}",
      "base_url": "${MRLIOU_BACKEND_B_URL}",
      "default_model": "mrliou-model-b1",
      "models": [
        "mrliou-model-b1",
        "mrliou-model-b2",
        "mrliou-model-b3"
      ]
    },
    {
      "name": "backend-c",
      "enabled": true,
      "api_key": "${MRLIOU_BACKEND_C_KEY}",
      "base_url": "${MRLIOU_BACKEND_C_URL}",
      "default_model": "mrliou-model-c1",
      "models": [
        "mrliou-model-c1"
      ]
    },
    {
      "name": "ollama",
      "enabled": true,
      "base_url": "http://localhost:11434",
      "default_model": "mrliou-local",
      "models": [
        "mrliou-local",
        "mrliou-local-code"
      ]
    },
    {
      "name": "backend-d",
      "enabled": false,
      "api_key": "${MRLIOU_BACKEND_D_KEY}",
      "endpoint": "${MRLIOU_BACKEND_D_ENDPOINT}",
      "deployment": "${MRLIOU_BACKEND_D_DEPLOYMENT}",
      "api_version": "2023-05-15",
      "models": [
        "mrliou-model-d1",
        "mrliou-model-d2"
      ]
    }
  ],
  "fallback": {
    "enabled": true,
    "order": [
      "backend-a",
      "backend-b",
      "ollama"
    ]
  }
}
