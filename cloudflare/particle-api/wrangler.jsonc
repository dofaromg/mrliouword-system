{
  "$schema": "node_modules/wrangler/config-schema.json",

  // 雲端資源名。依命名註冊表，particle-api 是 legacy alias，
  // 僅作為實作識別碼保留（quarantine_as_source_name），
  // 不得被當成現行產品或模組名稱；canonical 身分見下方 vars。
  "name": "particle-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-21",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ORIGIN_SIGNATURE": "MrLiouWord",
    "CANONICAL_MODULE": "MRL_API_Gateway",
    "SOURCE_NAME": "particle-api",
    "VERSION": "2.0.0"
  },
  "r2_buckets": [
    {
      "binding": "PARTICLES",
      "bucket_name": "mrlioubook"
    }
  ]
}
