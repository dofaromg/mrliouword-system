{
  "name": "mrliouword-unified-gateway",
  "version": "1.0.0",
  "description": "MrLiouWord Unified Gateway - 統一 API 閘道",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env production",
    "deploy:dev": "wrangler deploy --env development",
    "tail": "wrangler tail --env production",
    "db:init": "wrangler d1 execute mrliouword-db --env production --file=schema/d1-schema.sql",
    "db:seed:particles": "wrangler d1 execute mrliouword-db --env production --file=schema/seeds/particles.sql",
    "db:seed:layers": "wrangler d1 execute mrliouword-db --env production --file=schema/seeds/layers.sql",
    "db:seed": "npm run db:seed:particles && npm run db:seed:layers"
  },
  "keywords": [
    "mrliouword",
    "cloudflare",
    "workers",
    "unified-gateway"
  ],
  "author": "MR.liou",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.3.0",
    "wrangler": "^4.59.2"
  }
}
